{
  "name": "@mrpvi/fluentui-vue",
  "version": "0.1.1",
  "description": "Native Vue 3 components adapted from Fluent UI React v9.",
  "private": false,
  "license": "MIT",
  "author": "mrpvi",
  "keywords": [
    "vue",
    "vue3",
    "fluent-ui",
    "fluent-design",
    "components",
    "ui-library",
    "accessibility",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrpvi/fluentui-vue.git"
  },
  "homepage": "https://github.com/mrpvi/fluentui-vue#readme",
  "bugs": {
    "url": "https://github.com/mrpvi/fluentui-vue/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "tokens:generate": "node scripts/generate-theme-tokens.mjs",
    "tokens:check": "node scripts/generate-theme-tokens.mjs --check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit -p tsconfig.lib.json && vue-tsc --noEmit -p tsconfig.playground.json && vue-tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:a11y": "playwright test --config playwright.a11y.config.ts",
    "test:ssr": "vitest run --config vitest.ssr.config.ts",
    "test:browser": "playwright test --config playwright.config.ts --grep-invert @visual",
    "test:visual": "playwright test --config playwright.config.ts --project chromium --grep @visual",
    "build": "npm run tokens:check && npm run typecheck && vite build && node scripts/clean-build.mjs",
    "pack:check": "node scripts/verify-package-contents.mjs",
    "consumer:check": "npm run build && node scripts/verify-packed-consumer.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run test:a11y && npm run test:ssr && npm run build && npm run pack:check && npm run consumer:check"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fluentui/react-theme": "9.2.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "latest",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.41",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "latest"
  }
}
